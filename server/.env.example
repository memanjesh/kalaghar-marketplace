# Copy this file to .env and fill in your keys. Never commit .env.

# test | live
PAYMENT_MODE=test
PORT=8787
# Public address of this server, e.g. https://pay.kalaghar.com
PUBLIC_URL=http://localhost:8787
# Your website address(es), comma separated, e.g. https://kalaghar.com
ALLOWED_ORIGINS=

# Khalti — merchant dashboard → Keys → Live secret key (test key from dev.khalti.com)
KHALTI_SECRET_KEY=

# eSewa — product code and secret key from eSewa merchant onboarding
# (left empty in test mode, the public sandbox EPAYTEST credentials are used)
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=

# International cards — Stripe secret key (requires a Stripe account, e.g. via Stripe Atlas)
STRIPE_SECRET_KEY=
# Explicit settlement currency and reviewed conversion rate are required.
# Example only: for USD, set the current business-approved NPR→USD rate.
STRIPE_CURRENCY=
STRIPE_NPR_TO_CURRENCY_RATE=

# Shared data and authentication. All three are mandatory in live mode.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never add this to assets/config.js or any browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI listing assistant (server only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
